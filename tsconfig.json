{
	"compilerOptions": {
		"module": "NodeNext",
		"target": "es2020",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": false,
		"declaration": true,
		"declarationMap": true,
		"rootDir": "src",
		"outDir": "dist/",
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts"
	]
}
